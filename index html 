<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>King of Dangara Cricket Team</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f2f5f8;
      color: #222;
    }

    header {
      background: linear-gradient(135deg, #0b5ed7, #073b8c);
      color: white;
      text-align: center;
      padding: 30px 15px;
    }

    header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 16px;
    }

    nav {
      background: white;
      padding: 12px;
      text-align: center;
      box-shadow: 0 2px 8px #ccc;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav a {
      text-decoration: none;
      color: #0b5ed7;
      font-weight: bold;
      margin: 0 10px;
    }

    section {
      max-width: 900px;
      margin: 20px auto;
      padding: 20px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 3px 12px #ddd;
      margin-bottom: 20px;
    }

    h2 {
      color: #073b8c;
      margin-bottom: 15px;
    }

    input, select {
      width: 100%;
      padding: 13px;
      margin: 8px 0;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
      background: white;
    }

    button {
      width: 100%;
      padding: 13px;
      margin-top: 10px;
      border: none;
      border-radius: 8px;
      background: #0b5ed7;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #073b8c;
    }

    .player {
      background: #f7f9fc;
      border-left: 5px solid #0b5ed7;
      padding: 15px;
      margin: 10px 0;
      border-radius: 8px;
    }

    .player strong {
      font-size: 19px;
    }

    .stats {
      margin-top: 7px;
      color: #555;
    }

    .delete {
      background: #dc3545;
      font-size: 14px;
      padding: 8px;
    }

    footer {
      background: #073b8c;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 30px;
    }

    .notice {
      background: #fff3cd;
      padding: 12px;
      border-radius: 8px;
      margin-top: 10px;
      color: #664d03;
    }

    .winner-notice {
      background: #d1e7dd;
      padding: 15px;
      border-radius: 8px;
      margin-top: 15px;
      color: #0f5132;
      border-left: 5px solid #198754;
    }

    .top-performer {
      background: #e2e3e5;
      padding: 12px;
      border-radius: 8px;
      margin-top: 10px;
    }
  </style>
</head>

<body>

  <header>
    <h1>🏏 King of Dangara Cricket Team</h1>
    <p>Tournament & Player Info 🏆</p>
  </header>

  <nav>
    <a href="#home">Home & सूचना</a>
    <a href="#register">Player Registration</a>
    <a href="#players">Players List</a>
  </nav>

  <!-- HOME -->
  <section id="home">

    <div class="card">
      <h2>🏆 Tournament Information</h2>

      <p><b>Tournament:</b> Dangara Cricket Tournament</p>
      <p><b>Team:</b> King of Dangara</p>
      <p><b>Subject / Game:</b> Cricket</p>
      <p><b>Village:</b> Dangara</p>
      <p><b>District:</b> Jalore</p>

      <div class="notice">
        📢 सभी खिलाड़ी अपना नाम, Skill और जानकारी Registration Form में भर सकते हैं।
      </div>

      <!-- (i) Tournament सूचना & (ii) टीम विजेता सूचना -->
      <div class="winner-notice">
        <h3>🎉 (ii) टीम विजेता सूचना & Top Performers</h3>
        <p>🏆 <b>विजेता टीम:</b> King of Dangara</p>
        
        <div class="top-performer">
          <p>🏏 <b>सबसे ज्यादा रन बनाने वाला खिलाड़ी:</b> <span id="topScorer">कोई डेटा नहीं</span></p>
          <p>🎯 <b>सबसे ज्यादा विकेट लेने वाला खिलाड़ी:</b> <span id="topWicketTaker">कोई डेटा नहीं</span></p>
        </div>
      </div>
    </div>

  </section>

  <!-- REGISTRATION -->
  <section id="register">

    <div class="card">

      <h2>📝 Player Registration</h2>

      <input
        type="text"
        id="playerName"
        placeholder="Player का नाम">

      <select id="playerSkill">
        <option value="">-- Skill चुनें --</option>
        <option value="Batsman">Batsman</option>
        <option value="Bowler">Bowler</option>
        <option value="All Rounder">All Rounder</option>
      </select>

      <input
        type="text"
        id="teamName"
        placeholder="Team का नाम (Default: King of Dangara)"
        value="King of Dangara">

      <input
        type="number"
        id="runs"
        placeholder="Runs"
        min="0">

      <input
        type="number"
        id="wickets"
        placeholder="Wickets"
        min="0">

      <button onclick="addPlayer()">
        ➕ Player जोड़ें
      </button>

    </div>

  </section>

  <!-- PLAYER LIST -->
  <section id="players">

    <div class="card">

      <h2>👥 Player List</h2>

      <div id="playerList">
        <p>अभी कोई player नहीं जोड़ा गया।</p>
      </div>

    </div>

  </section>

  <footer>
    <p>🏏 King of Dangara Cricket Team</p>
    <p>📍 Village: Dangara, District: Jalore</p>
    <p>© 2026 King of Dangara</p>
  </footer>


  <script>

    // Default Players list from notebook image
    const initialPlayers = [
      { name: "MK Dahiya", skill: "Bowler", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Hukam", skill: "All Rounder", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Arvind Dahiya", skill: "All Rounder", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Vishal Kumar", skill: "Batsman", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Gotam", skill: "Batsman", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Parveen", skill: "Batsman", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Sanjay", skill: "Batsman", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Sarwan", skill: "All Rounder", team: "King of Dangara", runs: 0, wickets: 0 },
      { name: "Meeta Ram", skill: "Bowler", team: "King of Dangara", runs: 0, wickets: 0 }
    ];

    // LocalStorage से Data निकालना या Default सेट करना
    let players = JSON.parse(localStorage.getItem("dangaraPlayers"));

    if (!players || players.length === 0) {
      players = initialPlayers;
      localStorage.setItem("dangaraPlayers", JSON.stringify(players));
    }

    // Player जोड़ना
    function addPlayer() {
      const nameInput = document.getElementById("playerName");
      const skillInput = document.getElementById("playerSkill");
      const teamInput = document.getElementById("teamName");
      const runsInput = document.getElementById("runs");
      const wicketsInput = document.getElementById("wickets");

      const name = nameInput.value.trim();
      const skill = skillInput.value;
      const team = teamInput.value.trim();
      const runs = Math.max(0, parseInt(runsInput.value) || 0);
      const wickets = Math.max(0, parseInt(wicketsInput.value) || 0);

      if (name === "") {
        alert("कृपया Player का नाम लिखें।");
        return;
      }

      if (skill === "") {
        alert("कृपया Player की Skill चुनें।");
        return;
      }

      const player = {
        name: name,
        skill: skill,
        team: team || "King of Dangara",
        runs: runs,
        wickets: wickets
      };

      players.push(player);
      localStorage.setItem("dangaraPlayers", JSON.stringify(players));

      nameInput.value = "";
      skillInput.value = "";
      teamInput.value = "King of Dangara";
      runsInput.value = "";
      wicketsInput.value = "";

      displayPlayers();
      alert("✅ Player सफलतापूर्वक जोड़ दिया गया!");
    }

    // Players दिखाना और Top Performers अपडेट करना
    function displayPlayers() {
      const list = document.getElementById("playerList");

      if (players.length === 0) {
        list.innerHTML = "<p>अभी कोई player नहीं जोड़ा गया।</p>";
        updateTopPerformers();
        return;
      }

      list.innerHTML = "";

      players.forEach((player, index) => {
        list.innerHTML += `
          <div class="player">
            <strong>🏏 ${player.name}</strong> (${player.skill})
            <div class="stats">
              🏆 Team: ${player.team}<br>
              🏏 Runs: ${player.runs}<br>
              🎯 Wickets: ${player.wickets}
            </div>
            <button class="delete" onclick="deletePlayer(${index})">
              🗑️ Delete
            </button>
          </div>
        `;
      });

      updateTopPerformers();
    }

    // ज्यादा रन और ज्यादा विकेट वाले Player अपडेट करना
    function updateTopPerformers() {
      if (players.length === 0) {
        document.getElementById("topScorer").innerText = "कोई डेटा नहीं";
        document.getElementById("topWicketTaker").innerText = "कोई डेटा नहीं";
        return;
      }

      let topScorer = players[0];
      let topWicketTaker = players[0];

      players.forEach(p => {
        if (Number(p.runs) > Number(topScorer.runs)) topScorer = p;
        if (Number(p.wickets) > Number(topWicketTaker.wickets)) topWicketTaker = p;
      });

      document.getElementById("topScorer").innerText = `${topScorer.name} (${topScorer.runs} Runs)`;
      document.getElementById("topWicketTaker").innerText = `${topWicketTaker.name} (${topWicketTaker.wickets} Wickets)`;
    }

    // Player हटाना
    function deletePlayer(index) {
      if (confirm("क्या आप इस player को हटाना चाहते हैं?")) {
        players.splice(index, 1);
        localStorage.setItem("dangaraPlayers", JSON.stringify(players));
        displayPlayers();
      }
    }

    // Page खुलने पर players दिखाएँ
    displayPlayers();

  </script>

</body>
</html>
